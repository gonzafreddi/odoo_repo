<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_shop_password_reset_api" model="res.groups">
        <field name="name">Shop Password Reset API</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_customer_account_user" model="res.groups">
        <field name="name">Customer Account User</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_customer_account_manager" model="res.groups">
        <field name="name">Customer Account Manager</field>
        <field name="implied_ids" eval="[Command.link(ref('shop_customer_auth.group_customer_account_user'))]"/>
    </record>

    <record id="rule_customer_account_move_company" model="ir.rule">
        <field name="name">Cuenta corriente por compañías permitidas</field>
        <field name="model_id" ref="model_shop_customer_account_move"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('shop_customer_auth.group_customer_account_user'))]"/>
    </record>
</odoo>
