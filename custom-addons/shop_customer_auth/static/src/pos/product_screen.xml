<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="shop_customer_auth.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('rightpane')]//CategorySelector" position="after">
            <div t-if="!pos.scanning" class="shop-pos-view-switcher d-flex justify-content-end gap-1 px-2 py-1 bg-view border-bottom" role="group" aria-label="Product view">
                <button type="button" aria-label="Grid view" title="Grid view" class="btn btn-secondary shop-pos-view-button"
                    t-att-class="{ 'active': state.productViewMode === 'grid' }"
                    t-att-aria-pressed="state.productViewMode === 'grid' ? 'true' : 'false'"
                    t-on-click="() => this.setProductViewMode('grid')">
                    <i class="fa fa-th-large" aria-hidden="true"/>
                </button>
                <button type="button" aria-label="List view" title="List view" class="btn btn-secondary shop-pos-view-button"
                    t-att-class="{ 'active': state.productViewMode === 'list' }"
                    t-att-aria-pressed="state.productViewMode === 'list' ? 'true' : 'false'"
                    t-on-click="() => this.setProductViewMode('list')">
                    <i class="fa fa-list" aria-hidden="true"/>
                </button>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('rightpane')]//div[hasclass('product-list')]" position="attributes">
            <attribute name="t-att-class">{
                'shop-pos-product-list': true,
                'shop-pos-product-list--grid': state.productViewMode === 'grid',
                'shop-pos-product-list--list': state.productViewMode === 'list',
            }</attribute>
        </xpath>
        <xpath expr="//div[hasclass('rightpane')]//ProductCard" position="attributes">
            <attribute name="class">state.productViewMode === 'list' ? 'shop-pos-product-card shop-pos-product-card--list' : 'flex-column shop-pos-product-card shop-pos-product-card--grid'</attribute>
            <attribute name="price">getProductPrice(product)</attribute>
            <attribute name="originalPrice">getProductOriginalPrice(product)</attribute>
        </xpath>
    </t>

    <t t-name="shop_customer_auth.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass(&apos;product-content&apos;)]" position="after">
            <div t-if="props.price" class="shop-pos-product-price text-nowrap">
                <span class="fw-bolder" t-esc="props.price"/>
                <del t-if="props.originalPrice" class="shop-pos-product-original-price text-muted ms-1"
                    t-esc="props.originalPrice"/>
            </div>
        </xpath>
    </t>
</templates>
