<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="shop_customer_auth.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-buttons')]" position="inside">
            <button t-if="cardSurchargePercent > 0 and !isRefundOrder"
                class="button btn btn-secondary btn-lg d-flex justify-content-between align-items-baseline w-100 lh-lg"
                t-att-class="{ 'highlight active text-action': isCardSurchargeApplied }"
                t-on-click="toggleCardSurcharge">
                <span><i class="fa fa-credit-card me-2"/>Tarjeta / Mercado Pago +<t t-esc="cardSurchargePercent"/>%</span>
                <i class="fa me-2" t-attf-class="{{ isCardSurchargeApplied ? 'fa-check-square text-action' : 'fa-square-o' }}"/>
            </button>
        </xpath>
    </t>
</templates>
