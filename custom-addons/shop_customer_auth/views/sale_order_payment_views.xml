<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="shop_sale_payment_method_list" model="ir.ui.view">
        <field name="name">shop.sale.payment.method.list</field>
        <field name="model">shop.sale.payment.method</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="reference_required"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="shop_sale_payment_method_form" model="ir.ui.view">
        <field name="name">shop.sale.payment.method.form</field>
        <field name="model">shop.sale.payment.method</field>
        <field name="arch" type="xml">
            <form string="Medio de cobro web">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="reference_required"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shop_sale_payment_methods" model="ir.actions.act_window">
        <field name="name">Medios de cobro web</field>
        <field name="res_model">shop.sale.payment.method</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_shop_sale_payment_methods"
        name="Medios de cobro web"
        parent="sale.menu_sale_config"
        action="action_shop_sale_payment_methods"
        sequence="35"
        groups="sales_team.group_sale_manager"
    />

    <record id="shop_sale_payment_list" model="ir.ui.view">
        <field name="name">shop.sale.payment.list</field>
        <field name="model">shop.sale.payment</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="date"/>
                <field name="order_id"/>
                <field name="payment_method_id"/>
                <field name="amount"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="reference"/>
                <field name="user_id"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'confirmed'"
                    decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="shop_sale_payment_form" model="ir.ui.view">
        <field name="name">shop.sale.payment.form</field>
        <field name="model">shop.sale.payment</field>
        <field name="arch" type="xml">
            <form string="Cobro web" create="0" edit="0" delete="0">
                <header>
                    <button name="action_cancel" type="object" string="Anular"
                        class="btn-secondary" invisible="state != 'confirmed'"
                        groups="sales_team.group_sale_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="order_id"/>
                        <field name="payment_method_id"/>
                        <field name="amount"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="date"/>
                        <field name="reference"/>
                        <field name="user_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="shop_sale_payment_register_wizard_form" model="ir.ui.view">
        <field name="name">shop.sale.payment.register.wizard.form</field>
        <field name="model">shop.sale.payment.register.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar cobro web">
                <group>
                    <field name="order_id"/>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="payment_method_id" options="{'no_create': True}"/>
                    <field name="amount"/>
                    <field name="date"/>
                    <field name="reference"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Registrar cobro"
                        class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="sale_order_list_web_payment" model="ir.ui.view">
        <field name="name">sale.order.list.web.payment</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="amount_total" position="after">
                <field name="web_payment_state"
                    string="Estado de cobro"
                    widget="badge"
                    optional="show"
                    decoration-muted="web_payment_state == 'not_paid'"
                    decoration-warning="web_payment_state == 'partial'"
                    decoration-success="web_payment_state == 'paid'"/>
            </field>
        </field>
    </record>

    <record id="sale_order_search_web_payment" model="ir.ui.view">
        <field name="name">sale.order.search.web.payment</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <filter name="my_sale_orders_filter" position="after">
                <separator/>
                <filter name="web_payment_not_paid"
                    string="No pagado"
                    domain="[('web_payment_state', '=', 'not_paid')]"/>
                <filter name="web_payment_partial"
                    string="Pago parcial"
                    domain="[('web_payment_state', '=', 'partial')]"/>
                <filter name="web_payment_paid"
                    string="Pagado"
                    domain="[('web_payment_state', '=', 'paid')]"/>
            </filter>
            <filter name="preferred_payment_method_line_groupby" position="after">
                <filter name="group_by_web_payment_state"
                    string="Estado de cobro"
                    context="{'group_by': 'web_payment_state'}"/>
            </filter>
        </field>
    </record>

    <record id="sale_order_payment_form" model="ir.ui.view">
        <field name="name">sale.order.form.web.payment</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button string="Registrar cobro" name="action_validate_payment"
                    type="object" class="btn-primary"
                    invisible="state != 'sale' or web_payment_state == 'paid'"
                    groups="sales_team.group_sale_salesman"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <field name="web_payment_state" widget="badge"
                    decoration-success="web_payment_state == 'paid'"
                    decoration-warning="web_payment_state == 'partial'"
                    class="float-end"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Cobros web" name="web_payments">
                    <group>
                        <field name="web_amount_paid"/>
                        <field name="web_amount_due"/>
                    </group>
                    <field name="web_payment_ids" readonly="1">
                        <list create="0" delete="0">
                            <field name="date"/>
                            <field name="payment_method_id"/>
                            <field name="amount"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="reference"/>
                            <field name="user_id"/>
                            <field name="state" widget="badge"
                                decoration-success="state == 'confirmed'"
                                decoration-danger="state == 'cancelled'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
