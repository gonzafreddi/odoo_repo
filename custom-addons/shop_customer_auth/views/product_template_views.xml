<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_offer_price" model="ir.ui.view">
        <field name="name">product.template.form.offer.price</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="description_sale" string="Descripción"
                    placeholder="Ingrese una descripción del producto..."/>
            </field>
            <xpath expr="//div[@name='list_price_uom']" position="after">
                <field name="offer_active"/>
                <field name="offer_price" widget="monetary"
                    options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                <field name="margin_percentage" widget="percentage"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_list_view_offer_price" model="ir.ui.view">
        <field name="name">product.template.list.offer.price</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="description_sale" string="Descripción" optional="show"/>
            </field>
            <field name="list_price" position="after">
                <field name="offer_active" optional="show"/>
                <field name="offer_price" widget="monetary"
                    options="{'currency_field': 'currency_id'}" optional="show"/>
                <field name="margin_percentage" widget="percentage"/>
            </field>
        </field>
    </record>
</odoo>
