<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_register_customer_payment_form" model="ir.ui.view">
        <field name="name">shop.customer.account.payment.wizard.form</field>
        <field name="model">shop.customer.account.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar Cobranza">
                <group>
                    <field name="partner_id"/>
                    <field name="amount"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="date"/>
                    <field name="reference"/>
                    <field name="note"/>
                    <field name="company_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Registrar Cobranza"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
