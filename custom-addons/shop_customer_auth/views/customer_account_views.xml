<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_customer_account_move_list" model="ir.ui.view">
        <field name="name">shop.customer.account.move.list</field>
        <field name="model">shop.customer.account.move</field>
        <field name="arch" type="xml">
            <list string="Movimientos de Cuenta Corriente"
                  default_order="date desc,id desc" delete="0"
                  decoration-muted="state == 'cancelled'">
                <field name="date"/>
                <field name="partner_id"/>
                <field name="move_type"/>
                <field name="reference"/>
                <field name="pos_order_id"/>
                <field name="debit" sum="Total debe"/>
                <field name="credit" sum="Total haber"/>
                <field name="running_balance"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="user_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_customer_account_move_form" model="ir.ui.view">
        <field name="name">shop.customer.account.move.form</field>
        <field name="model">shop.customer.account.move</field>
        <field name="arch" type="xml">
            <form string="Movimiento de Cuenta Corriente" delete="0">
                <header>
                    <button name="action_cancel" type="object" string="Cancelar"
                            class="btn-secondary" invisible="state == 'cancelled'"
                            groups="shop_customer_auth.group_customer_account_manager"
                            confirm="El movimiento dejará de afectar el saldo. ¿Continuar?"/>
                    <button name="action_reactivate" type="object" string="Reactivar"
                            invisible="state != 'cancelled'"
                            groups="shop_customer_auth.group_customer_account_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" readonly="pos_payment_id"/>
                            <field name="date"/>
                            <field name="move_type" readonly="pos_payment_id"/>
                            <field name="amount" readonly="pos_payment_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="pos_payment_id"/>
                        </group>
                        <group>
                            <field name="reference"/>
                            <field name="user_id" readonly="1"/>
                            <field name="pos_order_id" readonly="pos_payment_id"/>
                            <field name="pos_payment_id" readonly="pos_payment_id"/>
                            <field name="signed_amount" readonly="1"/>
                            <field name="running_balance" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Observaciones del movimiento..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_customer_account_move_search" model="ir.ui.view">
        <field name="name">shop.customer.account.move.search</field>
        <field name="model">shop.customer.account.move</field>
        <field name="arch" type="xml">
            <search string="Movimientos de Cuenta Corriente">
                <field name="partner_id"/>
                <field name="reference"/>
                <field name="pos_order_id"/>
                <field name="user_id"/>
                <filter name="sales" string="Ventas" domain="[('move_type', '=', 'sale')]"/>
                <filter name="payments" string="Cobranzas" domain="[('move_type', '=', 'payment')]"/>
                <filter name="adjustments" string="Ajustes"
                        domain="[('move_type', 'in', ('debit_adjustment', 'credit_adjustment'))]"/>
                <filter name="cancelled" string="Cancelados" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="group_partner" string="Cliente" context="{'group_by': 'partner_id'}"/>
                <filter name="group_type" string="Tipo" context="{'group_by': 'move_type'}"/>
                <filter name="group_date" string="Fecha" context="{'group_by': 'date:month'}"/>
                <filter name="group_company" string="Compañía" context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="action_customer_account_moves" model="ir.actions.act_window">
        <field name="name">Movimientos</field>
        <field name="res_model">shop.customer.account.move</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_customer_account_move_search"/>
        <field name="context">{}</field>
    </record>
</odoo>
