<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="shop_product_objective_view_list" model="ir.ui.view">
        <field name="name">shop.product.objective.list</field>
        <field name="model">shop.product.objective</field>
        <field name="arch" type="xml">
            <list string="Objetivos" default_order="sequence">
                <field name="sequence" widget="handle"/>
                <field name="image" widget="image" string="Foto" options="{'size': [0, 48]}"/>
                <field name="name"/>
                <field name="slug"/>
                <field name="active"/>
                <field name="line_count" string="Productos" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="shop_product_objective_view_form" model="ir.ui.view">
        <field name="name">shop.product.objective.form</field>
        <field name="model">shop.product.objective</field>
        <field name="arch" type="xml">
            <form string="Objetivo">
                <sheet>
                    <group>
                        <group string="Foto de la card">
                            <field name="image" widget="image" nolabel="1" colspan="2"
                                   class="o_shop_objective_image"
                                   options="{'size': [240, 320]}"/>
                            <div class="text-muted small" colspan="2">
                                Usá el lápiz para subir o cambiar la foto. Recomendado:
                                vertical, 1200×1600 px, JPG.
                            </div>
                        </group>
                        <group>
                            <field name="name"/>
                            <field name="slug"/>
                            <field name="short_description"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" widget="html"/>
                    </group>
                    <notebook>
                        <page string="Productos">
                            <field name="line_ids">
                                <list editable="bottom" default_order="sequence">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_tmpl_id"/>
                                    <field name="featured"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="shop_product_objective_view_search" model="ir.ui.view">
        <field name="name">shop.product.objective.search</field>
        <field name="model">shop.product.objective</field>
        <field name="arch" type="xml">
            <search string="Buscar objetivos">
                <field name="name"/>
                <field name="slug"/>
                <separator/>
                <filter name="active" string="Activos" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archivados" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_shop_product_objective" model="ir.actions.act_window">
        <field name="name">Objetivos</field>
        <field name="res_model">shop.product.objective</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
