<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_objectives" model="ir.ui.view">
        <field name="name">product.template.form.objectives</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Objetivos">
                    <field name="objective_line_ids">
                        <list editable="bottom" default_order="sequence">
                            <field name="objective_id"/>
                            <field name="sequence" widget="handle"/>
                            <field name="featured"/>
                            <field name="active"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
